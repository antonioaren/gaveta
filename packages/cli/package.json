{
  "name": "@gaveta/cli",
  "version": "0.0.0",
  "private": true,
  "description": "gaveta / gv binary. Command registry, versioned JSON envelope, global options, and init, adopt, new, read, edit, and search.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
