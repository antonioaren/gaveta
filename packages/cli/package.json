  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gaveta/core": "workspace:*",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@gaveta/fixtures": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
