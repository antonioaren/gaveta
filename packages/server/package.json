{
  "name": "@gaveta/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local read/write API for gaveta serve (Fastify on 127.0.0.1).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.1",
    "@fastify/websocket": "11.2.0",
    "@gaveta/core": "workspace:*",
    "chokidar": "4.0.3",
    "fastify": "5.12.2"
  },
  "devDependencies": {
    "@gaveta/fixtures": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "ws": "8.21.0"
  }
