{
  "name": "gaveta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "lint": "eslint . && node tests/check-conflict-markers.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:nfr": "vitest run --config vitest.nfr.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:nfr && pnpm test:coverage && pnpm build:web && pnpm test:e2e && pnpm audit --audit-level=high",
    "dev": "pnpm --filter @gaveta/web dev",
    "build:web": "pnpm --filter @gaveta/web build",
    "seed": "node --experimental-strip-types scripts/seed-dev-vault.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gaveta/cli": "workspace:*",
    "@gaveta/core": "workspace:*",
    "@gaveta/fixtures": "workspace:*",
    "@types/node": "catalog:",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "playwright": "1.55.1",
    "prettier": "3.9.10",
    "typescript": "catalog:",
    "typescript-eslint": "8.72.0",
    "vitest": "catalog:",
    "ws": "8.21.0"
  }
}
