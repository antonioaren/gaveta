{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest.config.ts",
    "vitest.e2e.config.ts",
    "vitest.nfr.config.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts"
  ]
}
